{
  "name": "autoum-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autoum: Thorium with a local Pi browser assistant",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:extension-update": "node --import tsx scripts/extension-update-check.ts",
    "test:browser": "node --import tsx scripts/browser-smoke.ts",
    "test:live": "node --import tsx scripts/live-e2e.ts",
    "browser:fetch": "node scripts/fetch-browser.mjs",
    "start": "node scripts/launch.mjs",
    "package": "node scripts/package.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/install.mjs",
    "test:providers": "node --import tsx scripts/provider-e2e.ts",
    "test:jev": "node --import tsx scripts/jev-browser-check.ts",
    "test:voice": "node --import tsx scripts/voice-e2e.ts",
    "browser:voices": "node scripts/fetch-voice-models.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/yauzl": "^2.10.3",
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "marked": "18.0.11",
    "openai": "7.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typebox": "1.3.27",
    "ws": "8.22.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.0",
    "@met4citizen/headtts": "1.3.0",
    "@types/chrome": "0.0.287",
    "@types/node": "24.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.2",
    "esbuild": "0.25.12",
    "playwright-core": "1.58.2",
    "tsx": "4.21.0",
    "typescript": "6.0.2"
  }
}
